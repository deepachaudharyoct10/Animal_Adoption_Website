# MongoDB Atlas connection string
MONGODB_URI=

# Secret used to sign JWT auth tokens (any long random string)
JWT_SECRET=

# Gmail credentials used to send password-reset emails (use a Gmail App Password, not your login password)
EMAIL_USER=
EMAIL_PASS=

# Razorpay keys (from Razorpay dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Cloudinary credentials (from Cloudinary dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
